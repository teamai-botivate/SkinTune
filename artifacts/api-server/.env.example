# Copy to .env for local dev (never commit the real file).
# On Render, set these as environment variables in the service dashboard instead.

PORT=5000

# Required for /api/recommendations and /api/generate-images.
# Without this set, both routes return a clear 502 error and the frontend
# falls back to its mock data automatically.
OPENAI_API_KEY=

# Optional overrides — defaults shown.
# OPENAI_TEXT_MODEL=gpt-4o
# OPENAI_IMAGE_MODEL=gpt-image-2

# Required for /api/search-dresses (real-dress web search, real-dress-search
# branch only). Get a key at https://app.tavily.com — without it, that route
# returns a clear 502 and the frontend falls back to no results.
TAVILY_API_KEY=
