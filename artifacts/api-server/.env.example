# Copy to .env for local dev (never commit the real file).
# On Render, set these as environment variables in the service dashboard instead.

PORT=5000

# Required for /api/recommendations and /api/generate-images.
# Without this set, both routes return a clear 502 error and the frontend
# falls back to its mock data automatically.
OPENAI_API_KEY=

# Optional overrides — defaults shown.
# OPENAI_REASONING_MODEL=gpt-5.5   (preferred name — OPENAI_TEXT_MODEL is kept as a fallback alias)
# OPENAI_REASONING_FALLBACK_MODEL= (unset by default — see openai-client.ts)
# OPENAI_IMAGE_MODEL=gpt-image-2

# real-dress-avatar-intelligent-tryon branch: which SearchProvider
# /api/search-dresses uses — "tavily" (DEFAULT — Tavily's direct search
# API, fast and cheap; needs TAVILY_API_KEY below) or "openai" (uses
# OpenAI's real Responses API web_search tool instead — no separate key
# needed beyond OPENAI_API_KEY above, but confirmed live to be both
# noticeably slower AND noticeably more expensive per search than Tavily,
# since each search fans out into several real web_search tool calls —
# see lib/providers/search/index.ts's doc comment for the full story on
# why the default was flipped back to "tavily"). Kept as an explicit
# opt-in for anyone who wants GPT-based search again later.
# SEARCH_PROVIDER=tavily

# Required when SEARCH_PROVIDER is "tavily" (the default). Get a key at
# https://app.tavily.com — without it, that provider returns a clear 502.
TAVILY_API_KEY=

# real-dress-avatar-intelligent-tryon branch: which VtoProvider
# /api/avatar/create and /api/try-on use — "openai" (default, this
# branch's original OpenAI Responses-API image_generation/images.edit
# mechanism, no separate key needed beyond OPENAI_API_KEY above) or
# "fashn" (FASHN's Face to Model / Try-On Max endpoints — see
# lib/providers/vto/fashn-vto-provider.ts for exactly what was verified
# against FASHN's own docs).
# VTO_PROVIDER=openai

# Only needed if VTO_PROVIDER=fashn. Get a key at https://app.fashn.ai —
# without it, that provider throws a clear "FASHN_API_KEY is not set" error.
FASHN_API_KEY=
